---

import TagList from "virtual:tylant/components/TagList";
import Giscus from "@myriaddreamin/tylant/src/components/Giscus.astro";

import BaseHead from "virtual:tylant/components/minimal/BaseHead";
import Footer from "virtual:tylant/components/minimal/Footer";
import FormattedDate from "virtual:tylant/components/minimal/FormattedDate";
import Header from "virtual:tylant/components/minimal/Header";

interface BlogEntryData {
  id: string | false;
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
}

interface Props extends BlogEntryData {}

const {
  id,
  title,
  description,
  date,
  updatedDate,
  tags,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style is:global>
      .prose,
      ul.tags {
        max-width: min(60rem, calc(100% - 2em));
        margin: auto;
      }
      .prose {
        padding: 1em;
      }
      .prose p {
        margin-block-start: 0.5em;
        margin-block-end: 0.75em;
      }
      .title {
        margin-bottom: 1em;
        padding-bottom: 1em;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
      }
      .title h1 {
        margin: 0 0 0.5em;
      }
      .annotation {
        color: var(--md-sys-color-on-surface-variant);
        display: flex;
        gap: 0.5em;
        flex-wrap: wrap;
        margin-bottom: 0.75em;
        font-size: 0.9em;
      }
      .last-updated-on {
        font-style: italic;
      }
      ul.tags {
        list-style: none;
        padding: 0;
      }
      .outline {
        background: var(--md-sys-color-surface-variant);
        border-radius: var(--md-sys-shape-medium);
        padding: 1em 1.5em;
        margin: 1em 0;
      }
      .outline-item {
        line-height: 1.8889;
      }
      .outline-item.x-heading-1 {
        margin-left: 0em;
      }
      .outline-item.x-heading-2 {
        margin-left: 1em;
      }
      .outline-item.x-heading-3 {
        margin-left: 2em;
      }
      .outline-item.x-heading-4 {
        margin-left: 3em;
      }
      .outline-item.x-heading-5 {
        margin-left: 4em;
      }
    </style>
  </head>

  <body>
    <Header articleId={typeof id === "string" ? id : undefined} />
    <main>
      <md-elevated-card>
        <article class="card-content">
          <div class="prose">
            <section class="title" aria-label="Title">
              <div class="annotation">
                <div class="date">
                  <FormattedDate date={date} />
                  {
                    updatedDate && (
                      <span class="last-updated-on">
                        , Last updated on{" "}
                        <FormattedDate date={updatedDate} />
                      </span>
                    )
                  }
                </div>
              </div>
              <h1>{title}</h1>
            </section>
            <slot />
          </div>
          {tags && tags.length > 0 && <TagList tags={tags} />}
        </article>
      </md-elevated-card>
      {typeof id === "string" && id && <Giscus />}
    </main>
    <Footer />
  </body>
</html>
